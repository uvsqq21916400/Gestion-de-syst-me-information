<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ui.LoginController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label prefHeight="36.0" prefWidth="230.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Connexion" />
    <TextField fx:id="userField" promptText="Admin" />
    <PasswordField fx:id="passField" promptText="Mots de passe" />

    <Button onAction="#onLogin" text="Se connecter" />
    <Label fx:id="statusLabel" style="-fx-text-fill: #b00020;" text="" />

</VBox>
